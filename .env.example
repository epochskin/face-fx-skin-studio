# Copy to .env.local for local work. In production set these in Vercel > Settings > Environment Variables
# and redeploy. Never commit real values.

# --- Booking mode ---------------------------------------------------------------
# "native" (default): the on-site flow (/book -> Stripe deposit -> email). Needs the keys below.
# "square": every Book Now opens the studio's Square page instead (set NEXT_PUBLIC_BOOKING_URL too).
NEXT_PUBLIC_BOOKING_MODE=native
NEXT_PUBLIC_BOOKING_URL=https://face-fx-skin-studio.square.site/

# --- Site ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Turso (one database for this site only) ----------------------------------------
TURSO_DATABASE_URL=libsql://face-fx-bookings-yourorg.turso.io
TURSO_AUTH_TOKEN=

# --- Stripe -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From Stripe Dashboard > Developers > Webhooks > endpoint https://your-domain.com/api/stripe/webhook
# listening for checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend ---------------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Use onboarding@resend.dev until the studio's domain is verified in Resend
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where new-booking alerts go (the studio owner). Falls back to the public studio email.
RESEND_TO_EMAIL=

# --- Admin (/admin/bookings) and calendar feed -------------------------------------------------
ADMIN_PASSWORD=
# Long random string. The feed lives at /api/calendar.ics?token=<this value>
CALENDAR_FEED_TOKEN=
